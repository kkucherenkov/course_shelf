{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.example", ".nvmrc", "packages/tsconfig/base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@app/design-tokens#build"],
      "outputs": ["dist/**", ".output/**", ".nuxt/**", "build/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "dev": {
      "dependsOn": ["@app/design-tokens#build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["@app/design-tokens#build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "@app/design-tokens#build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "@app/design-tokens#build"],
      "outputs": ["*.tsbuildinfo"]
    },
    "audit:components": {
      "cache": false,
      "outputs": []
    },
    "@app/specs#validate": {
      "outputs": []
    },
    "@app/specs#bundle": {
      "dependsOn": ["@app/specs#validate"],
      "outputs": ["dist/**"]
    },
    "@app/specs#codegen": {
      "dependsOn": ["@app/specs#bundle"],
      "outputs": ["../api-client-ts/src/generated/**", "../api-client-dart/lib/generated/**"]
    },
    "@app/specs#contract-test": {
      "dependsOn": ["@app/specs#bundle"],
      "cache": false,
      // Turbo 2 hands tasks a strictly filtered environment. Without this the
      // script saw neither variable no matter what the caller exported: the
      // first authenticated contract run in e2e.yml minted a valid admin token
      // and then ran unauthenticated anyway, reporting the same "63 operations
      // returned only 401" warning the token was there to remove.
      "passThroughEnv": [
        "CONTRACT_TEST_BASE_URL",
        "CONTRACT_TEST_BEARER_TOKEN",
        "CONTRACT_TEST_REQUIRE_AUTH"
      ]
    },
    "@app/design-tokens#build": {
      "inputs": ["src/**", "$TURBO_ROOT$/docs/design/shared/**"],
      "outputs": [
        "../../apps/web/app/assets/css/tokens.generated.css",
        "../../apps/web/app/design-tokens.generated.ts",
        "../../packages/ui/src/tokens.generated.css",
        "../../packages/ui/src/design-tokens.generated.ts",
        "../../packages/ui_flutter/lib/src/theme/tokens.g.dart"
      ]
    }
  }
}
