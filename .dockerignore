# Keep the build context lean. The production Dockerfiles in apps/*/Dockerfile
# use the repo root as their context so they can see every workspace package
# manifest; everything below gets pruned out before the COPY layers run.

# pnpm + node_modules — repopulated by `pnpm install` in the build stage
**/node_modules
.pnpm-store

# Nuxt + Vite + Turbo build caches
# Both need `**/` — they live at `apps/web/.nuxt` and `apps/web/.output`, and a
# bare pattern matches only the context root. Without it a developer's local
# (possibly half-generated) `.nuxt` is copied into the image, `nuxt generate`
# finds the directory already there, does not recreate it, and the build dies
# on a missing `.nuxt/tsconfig.json`. CI never sees it — a fresh checkout has
# no `.nuxt` — so it surfaces as "the release image build is broken on my
# machine only" (#805).
**/.nuxt
**/.output
**/.turbo
**/.cache

# Test + coverage artefacts
**/coverage
**/.vitest
**/__snapshots__/.tmp

# Mobile + Dart client — not part of the web/backend release images
apps/mobile
packages/api-client-dart

# Storybook static output (rebuilt if needed)
packages/ui/storybook-static

# Local env + git noise
.env
.env.*
!.env.example
!.env.production.example
.git
.github
.husky
.idea
.vscode
.DS_Store
**/*.log

# Tests + e2e — not needed in the runtime image
tests
playwright-report
test-results

# Course-content samples checked into the repo for local testing —
# 9+ GB of mp4 that would balloon the build context. Production
# deployments mount their own course directory via $COURSES_PATH.
docs/data

# Model weights bound at dev/prod time via $WHISPER_MODEL_DIR (whisper's
# ggml .bin AND llama's gguf, gigabytes each) — never baked into the image,
# see apps/backend/Dockerfile's stage W/L comments. Same directory
# `.gitignore` already excludes; excluded here too since a local checkout
# can have weights sitting right next to the repo root that `docker build`
# would otherwise happily copy into the build context.
/models

# Derived artefacts (transcripts, thumbnails, scraper defs) bound at dev/prod
# time via $DERIVED_PATH — same reasoning as /models above. .env.example and
# docker/compose.yml both default it to repo-root derived/.
/derived

