<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline lesson playback runs over plain HTTP on the loopback interface.

  `downloaded_lessons.filePath` holds AES-GCM ciphertext that ExoPlayer cannot
  open, so `LoopbackDecryptServer` serves the decrypted bytes from
  `http://127.0.0.1:<ephemeral port>` and `video_player` plays that URL. From
  targetSdk 28 onwards the platform default is `cleartextTrafficPermitted="false"`
  for every host — 127.0.0.1 included — and ExoPlayer's `DefaultHttpDataSource`
  goes through `HttpURLConnection`, which enforces it. Without this file every
  offline play fails with "CLEARTEXT communication to 127.0.0.1 not permitted".

  Scoped to loopback rather than the blanket `android:usesCleartextTraffic="true"`:
  nothing else in the app may fall back to plain HTTP. iOS has the counterpart
  exception (`NSAllowsLocalNetworking` in `ios/Runner/Info.plist`).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
