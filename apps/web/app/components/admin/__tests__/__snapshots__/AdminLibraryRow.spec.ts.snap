  <div data-v-9ac31328="" class="adm-lib-row__icon" aria-hidden="true"><svg data-v-9ac31328="" class="stub-icon" data-name="library"></svg></div><!-- Name + sub-line -->
  <div data-v-9ac31328="" class="adm-lib-row__name-col">
